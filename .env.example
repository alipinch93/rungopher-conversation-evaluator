# RunGopher Conversation Evaluation Pipeline
# Copy this file to .env and fill in your API key
# NEVER commit .env to version control

OPENAI_API_KEY=sk-your-key-here

# Model to use for summarization, clustering, and report generation
# Options: gpt-4o-mini (default, fast), gpt-4o (higher quality)
OPENAI_MODEL=gpt-4o-mini

# Processing settings (adjust for performance vs cost)
BATCH_SIZE=300
PII_THRESHOLD=0.4
CONCURRENCY=10
